          "source_id": "issueInstanceId",
          "category": "issueName",
          "fortify_category": "kingdom",
          "criticality_raw": "friority",
          "primary_location": "primaryLocation",
          "line_number": "lineNumber",
          "full_filename": "fullFileName",
          "analyzer_type": "analyzer",
          "primary_rule_id": "primaryRuleGuid",
          "cwe_ids": "cwe"
        }
      }
    },
    {
      "label": "ToolB",
      "kind": "excel_md",
      "sheet_name": "ToolB",
      "sources": [
        {"role": "inventory", "kind": "excel", "path": "@target", "sheet": "ToolB"},
        {"role": "details", "kind": "md", "path": "toolb/toolb_details.md", "profile": "heading-kv-v1"}
      ]
    },
    {
      "label": "ToolC",
      "kind": "md",
      "sheet_name": null,
      "sources": [{"role": "findings", "kind": "md", "path": "toolc/toolc_report.md", "profile": "table-v1"}]
    }
  ]
